.env
.env.*
.envrc

# Rust
/target/
**/*.rs.bk

# Docusaurus generated folders
website/translated_docs/
website/build/
website/i18n/
website/.docusaurus/

# Yarn/Node
website/node_modules/
website/package-lock.json
node_modules/

# Generated docs
docs/contributing.md

# Agent temporary outputs
.agents/out/
.morphir/out/

# Ruby/Jekyll
.gems/
docs/Gemfile.lock
docs/_site/
docs/.jekyll-cache/

# Morphir launcher cache (local testing)
.morphir-version.local

# Build artifacts (staged binaries for testing)
.morphir/build/

# Downloaded tool cache (the release workflow caches this path too)
.morphir/cache/

# Python bytecode and test caches.
#
# Both extension artifact tasks run `python3 scripts/package_extension.py`
# before they check `git status`, and take a provenance-free "dirty worktree"
# branch when that check finds anything. Without these rules the interpreter's
# own bytecode cache made the worktree dirty, so the task produced a
# descriptor with no `gitCommit` and `select_extension_assets.py` rejected it.
__pycache__/
*.py[cod]
.pytest_cache/
