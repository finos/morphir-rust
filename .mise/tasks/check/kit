#!/bin/sh
#MISE description="Run the Morphir Compatibility Kit against the adapter and adjudicate the report"

# The kit is the oracle for what the IR spellings mean: the driver reads its cases, drives this
# binding's adapter over the JSON-lines testee protocol, and writes one record per fence. This
# task fetches the driver, runs it, and then hands the report to `tests/report.rs`, which holds
# the failing cases against `crates/morphir-mck-adapter/allowed-failing.json`.
#
# The released driver embeds the kit, so there is no --kit argument. Running against a working
# copy of the kit instead is `bun <morphir-typescript>/packages/mck/src/cli.ts run --kit <kit>`.

set -eu

VERSION=$(cat .config/mck-driver-version)
REPORT=.dev/out/mck/report.json
BIN_DIR=.dev/bin
DRIVER="$BIN_DIR/mck-$VERSION"

# The release publishes one binary per platform, named for the pair `uname` reports.
case "$(uname -s)" in
    Darwin) OS=darwin ;;
    Linux) OS=linux ;;
    *)
        echo "check:kit runs on Linux and macOS; on Windows run the driver from source with bun." >&2
        exit 1
        ;;
esac
case "$(uname -m)" in
    arm64 | aarch64) ARCH=arm64 ;;
    x86_64 | amd64) ARCH=x64 ;;
    *)
        echo "no mck driver is published for $(uname -m)." >&2
        exit 1
        ;;
esac

ASSET="mck-$VERSION-$OS-$ARCH"
RELEASE="https://github.com/finos/morphir-typescript/releases/download/v$VERSION"

# The checksum tool is spelled differently on the two platforms, and only GNU coreutils has the
# `-c` form that reads a SHA256SUMS line.
verify() {
    file=$1
    expected=$2
    if command -v sha256sum >/dev/null 2>&1; then
        actual=$(sha256sum "$file" | cut -d' ' -f1)
    else
        actual=$(shasum -a 256 "$file" | cut -d' ' -f1)
    fi
    [ "$actual" = "$expected" ] || {
        echo "checksum mismatch for $ASSET: expected $expected, got $actual" >&2
        return 1
    }
}

if [ ! -x "$DRIVER" ]; then
    echo "Fetching the mck driver $VERSION for $OS-$ARCH..."
    mkdir -p "$BIN_DIR"
    # Downloaded beside the target and moved into place only once it is whole and verified, so an
    # interrupted or corrupt fetch never leaves something at $DRIVER that the next run would take
    # for a good cached copy.
    TEMP="$DRIVER.download.$$"
    SUMS="$BIN_DIR/SHA256SUMS.$VERSION.$$"
    trap 'rm -f "$TEMP" "$SUMS"' EXIT
    curl --fail --location --silent --show-error --output "$TEMP" "$RELEASE/$ASSET"
    curl --fail --location --silent --show-error --output "$SUMS" "$RELEASE/SHA256SUMS"

    EXPECTED=$(awk -v asset="$ASSET" '$2 == asset || $2 == "*" asset { print $1 }' "$SUMS")
    [ -n "$EXPECTED" ] || {
        echo "SHA256SUMS for v$VERSION has no line for $ASSET." >&2
        exit 1
    }
    verify "$TEMP" "$EXPECTED" || exit 1

    chmod +x "$TEMP"
    mv "$TEMP" "$DRIVER"
    rm -f "$SUMS"
    trap - EXIT
fi

echo "Building the adapter..."
# The adapter is not in the workspace's default-members, so it is named explicitly.
cargo build -p morphir-mck-adapter

echo "Running the kit..."
mkdir -p "$(dirname "$REPORT")"
# A report from a previous run must never be what gets adjudicated, so the old one goes before
# the driver starts rather than being counted on to be overwritten.
rm -f "$REPORT"

# The driver exits 1 when any case failed. That is not this task's verdict — the list of cases a
# kit defect is open against is — so 1 is kept and reported after the adjudication. Any other
# non-zero status is the driver itself failing (a crash, a missing binary, a bad argument), and
# there is nothing to adjudicate then.
DRIVER_STATUS=0
"$DRIVER" run --adapter target/debug/mck-adapter-rust --report "$REPORT" || DRIVER_STATUS=$?
if [ "$DRIVER_STATUS" -gt 1 ]; then
    echo "The mck driver exited $DRIVER_STATUS, which is not a case verdict." >&2
    exit "$DRIVER_STATUS"
fi
[ -f "$REPORT" ] || {
    echo "The driver exited $DRIVER_STATUS but wrote no report at $REPORT." >&2
    exit 1
}

echo "Adjudicating the report against allowed-failing.json..."
cargo test -p morphir-mck-adapter --test report

if [ "$DRIVER_STATUS" -ne 0 ]; then
    echo "The driver exited $DRIVER_STATUS; every failing case is in allowed-failing.json." >&2
fi
