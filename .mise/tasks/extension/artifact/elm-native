#!/bin/sh
#MISE description="Build and validate the independently versioned native Elm extension bundle"

set -eu
export PYTHONDONTWRITEBYTECODE=1

SNAPSHOT_MODE="${MORPHIR_ELM_NATIVE_SNAPSHOT_MODE:-0}"
TASK_DIR="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)"
case "$SNAPSHOT_MODE" in
    0)
        REPO_ROOT="$(git -C "$TASK_DIR" rev-parse --show-toplevel)"
        ;;
    1)
        REPO_ROOT="$(CDPATH='' cd -- "$TASK_DIR/../../../.." && pwd -P)"
        ;;
    *)
        echo "MORPHIR_ELM_NATIVE_SNAPSHOT_MODE must be 0 or 1" >&2
        exit 1
        ;;
esac
cd "$REPO_ROOT"

STAGING_DIR="$REPO_ROOT/.morphir/build/extensions/elm-native"
TARGET_DIR="${CARGO_TARGET_DIR:-$REPO_ROOT/target}"
case "$TARGET_DIR" in
    /*) ;;
    *) TARGET_DIR="$REPO_ROOT/$TARGET_DIR" ;;
esac
export CARGO_TARGET_DIR="$TARGET_DIR"
WASM="$TARGET_DIR/wasm32-unknown-unknown/release/morphir_elm_binding.wasm"

if ! command -v python3 >/dev/null 2>&1; then
    echo "Python 3.11 or newer is required to package extensions" >&2
    exit 1
fi
if ! python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)'; then
    echo "Python 3.11 or newer is required to package extensions" >&2
    exit 1
fi
resolve_versioned_tool() {
    base="$1"
    if command -v "$base" >/dev/null 2>&1; then
        command -v "$base"
        return 0
    fi
    v=20
    while [ "$v" -ge 14 ]; do
        if command -v "$base-$v" >/dev/null 2>&1; then
            command -v "$base-$v"
            return 0
        fi
        v=$((v - 1))
    done
    return 1
}

if CLANG_PATH="$(resolve_versioned_tool clang)"; then
    case "$CLANG_PATH" in
        */clang) ;;
        *) export CC_wasm32_unknown_unknown="$CLANG_PATH" ;;
    esac
else
    echo "clang is required to compile the vendored tree-sitter grammar for wasm32-unknown-unknown" >&2
    exit 1
fi

if LLVM_AR_PATH="$(resolve_versioned_tool llvm-ar)"; then
    export AR_wasm32_unknown_unknown="$LLVM_AR_PATH"
elif LLVM_AR_PATH="$(dirname -- "$CLANG_PATH")/llvm-ar" && [ -x "$LLVM_AR_PATH" ]; then
    export AR_wasm32_unknown_unknown="$LLVM_AR_PATH"
else
    echo "llvm-ar is required to archive the vendored tree-sitter grammar for wasm32-unknown-unknown" >&2
    exit 1
fi

require_snapshot_file() {
    relative="$1"
    if [ ! -f "$REPO_ROOT/$relative" ] || [ -L "$REPO_ROOT/$relative" ]; then
        echo "required provenance input is missing or unsafe: $relative" >&2
        exit 1
    fi
}

require_snapshot_executable() {
    relative="$1"
    require_snapshot_file "$relative"
    if [ ! -x "$REPO_ROOT/$relative" ]; then
        echo "required provenance input is not executable: $relative" >&2
        exit 1
    fi
}

require_snapshot_tree() {
    relative="$1"
    if [ ! -d "$REPO_ROOT/$relative" ] || [ -L "$REPO_ROOT/$relative" ]; then
        echo "required provenance input is missing or unsafe: $relative" >&2
        exit 1
    fi
    if ! find "$REPO_ROOT/$relative" -type f -print -quit | grep -q .; then
        echo "required provenance input is missing or empty: $relative" >&2
        exit 1
    fi
}

require_snapshot_inputs() {
    require_snapshot_executable ".mise/tasks/extension/artifact/elm-native"
    require_snapshot_file "Cargo.toml"
    require_snapshot_file "Cargo.lock"
    require_snapshot_file "mise.toml"
    require_snapshot_file ".github/extensions.toml"
    require_snapshot_file "scripts/package_extension.py"
    require_snapshot_file "scripts/extension_packaging/__init__.py"
    require_snapshot_file "scripts/extension_packaging/bundles.py"
    require_snapshot_file "scripts/extension_packaging/cli.py"
    require_snapshot_file "scripts/extension_packaging/errors.py"
    require_snapshot_file "scripts/extension_packaging/model.py"
    require_snapshot_file "scripts/extension_packaging/paths.py"
    require_snapshot_file "tests/ci/test_package_extension.py"
    require_snapshot_file "tests/ci/package_extension_test_support.py"
    require_snapshot_file "tests/ci/test_package_extension_packaging.py"
    require_snapshot_file "tests/ci/test_package_extension_task.py"
    require_snapshot_file "tests/ci/test_extension_release_routing.py"
    require_snapshot_file "crates/morphir-elm-binding/Cargo.toml"
    require_snapshot_file "crates/morphir-elm-binding/build.rs"
    require_snapshot_file "crates/morphir-elm-binding/src/lib.rs"
    require_snapshot_file "crates/morphir-host-native/tests/elm_native_extension.rs"
    require_snapshot_file "crates/morphir-host-native/tests/support/mod.rs"
    require_snapshot_file "crates/morphir-host-native/tests/support/installed_wasm.rs"
    require_snapshot_file "crates/morphir-host-native/tests/support/mep.rs"
    require_snapshot_tree "scripts"
    require_snapshot_tree "crates/morphir-elm-binding/src"
    require_snapshot_tree "crates/morphir-elm-binding/tests"
    require_snapshot_tree "crates/morphir-elm-binding/grammar"
    require_snapshot_tree "crates/morphir-elm-binding/preludes"
    require_snapshot_tree "crates/morphir-extension-sdk/src"
    require_snapshot_tree "crates/morphir-core/src"
    require_snapshot_tree "crates/morphir-host-native/tests/support"
    require_snapshot_tree "crates/morphir-host-native/tests/fixtures/morphir-elm-extension"
    require_snapshot_tree "crates/morphir-distribution/src"
    if find "$REPO_ROOT" -type l -print -quit | grep -q .; then
        echo "provenance snapshot contains a symbolic link" >&2
        exit 1
    fi
}

run_pipeline() {
    source_root="$1"
    output="$2"
    git_commit="$3"
    (
        cd "$source_root"
        cargo test --locked -p morphir-elm-binding
        cargo build --locked --release -p morphir-elm-binding --target wasm32-unknown-unknown
        wasm-tools validate "$WASM"
        MORPHIR_ELM_GUEST="$WASM" cargo test --locked -p morphir-elm-binding --features wasm-host-tests --test wasm -- --ignored
        set -- scripts/package_extension.py \
            --short-id elm-native \
            --wasm "$WASM" \
            --output "$output"
        if [ -n "$git_commit" ]; then
            set -- "$@" --git-commit "$git_commit"
        fi
        python3 "$@"
        MORPHIR_ELM_NATIVE_BUNDLE="$output" cargo test --locked -p morphir-host-native --test elm_native_extension -- --ignored
    )
}

if [ "$SNAPSHOT_MODE" = 1 ]; then
    if [ -z "${MORPHIR_ELM_NATIVE_HEAD_COMMIT:-}" ]; then
        echo "MORPHIR_ELM_NATIVE_HEAD_COMMIT is required in snapshot mode" >&2
        exit 1
    fi
    if git -C "$REPO_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo "snapshot source must not be inside a Git worktree" >&2
        exit 1
    fi
    require_snapshot_inputs
    export MISE_CONFIG_FILE="$REPO_ROOT/mise.toml"
    python3 scripts/package_extension.py --clean-extension-staging elm-native
    run_pipeline "$REPO_ROOT" "$STAGING_DIR" "$MORPHIR_ELM_NATIVE_HEAD_COMMIT"
    exit 0
fi

python3 scripts/package_extension.py --validate-extension-staging elm-native
if ! WORKTREE_STATUS="$(git status --porcelain --untracked-files=normal)"; then
    echo "Could not determine Git worktree status" >&2
    exit 1
fi

if [ -n "$WORKTREE_STATUS" ]; then
    python3 scripts/package_extension.py --clean-extension-staging elm-native
    run_pipeline "$REPO_ROOT" "$STAGING_DIR" ""
    exit 0
fi

HEAD_COMMIT="$(git rev-parse HEAD)"
SNAPSHOT_ROOT=""
SNAPSHOT_ACTIVE=false
cleanup_snapshot() {
    if [ "$SNAPSHOT_ACTIVE" = true ]; then
        python3 "$REPO_ROOT/scripts/package_extension.py" \
            --clean-head-snapshot "$SNAPSHOT_ROOT" --short-id elm-native
    fi
}
trap cleanup_snapshot EXIT
trap 'exit 1' HUP INT TERM

SNAPSHOT_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/morphir-elm-native-head.XXXXXX")"
SNAPSHOT_ACTIVE=true
SNAPSHOT_ROOT="$(CDPATH='' cd -- "$SNAPSHOT_ROOT" && pwd -P)"
case "$SNAPSHOT_ROOT/" in
    "$REPO_ROOT/"*)
        echo "HEAD snapshot must be outside repository: $SNAPSHOT_ROOT" >&2
        exit 1
        ;;
esac
mkdir "$SNAPSHOT_ROOT/source"
git archive --format=tar --output="$SNAPSHOT_ROOT/head.tar" "$HEAD_COMMIT"
tar -xf "$SNAPSHOT_ROOT/head.tar" -C "$SNAPSHOT_ROOT/source"

if find "$SNAPSHOT_ROOT/source" -type l -print -quit | grep -q .; then
    echo "provenance snapshot contains a symbolic link" >&2
    exit 1
fi

ARCHIVED_TASK="$SNAPSHOT_ROOT/source/.mise/tasks/extension/artifact/elm-native"
if [ ! -f "$ARCHIVED_TASK" ] || [ -L "$ARCHIVED_TASK" ] || [ ! -x "$ARCHIVED_TASK" ]; then
    echo "required provenance input is missing or unsafe: .mise/tasks/extension/artifact/elm-native" >&2
    exit 1
fi
MORPHIR_ELM_NATIVE_SNAPSHOT_MODE=1 \
    MORPHIR_ELM_NATIVE_HEAD_COMMIT="$HEAD_COMMIT" \
    "$ARCHIVED_TASK"

SNAPSHOT_BUNDLE="$SNAPSHOT_ROOT/source/.morphir/build/extensions/elm-native"
python3 scripts/package_extension.py --clean-extension-staging elm-native
python3 scripts/package_extension.py \
    --transfer-bundle "$SNAPSHOT_BUNDLE" \
    --output "$STAGING_DIR"

cleanup_snapshot
SNAPSHOT_ACTIVE=false
trap - EXIT HUP INT TERM
