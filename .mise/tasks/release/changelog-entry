#!/bin/sh
#MISE description="Add an entry to the Unreleased section of CHANGELOG.md"

CATEGORY="${1:-}"
ENTRY="${2:-}"

if [ -z "$CATEGORY" ] || [ -z "$ENTRY" ]; then
    echo "Usage: mise run release:changelog-entry <category> <entry>"
    echo ""
    echo "Categories: Added, Changed, Deprecated, Removed, Fixed, Security"
    echo ""
    echo "Example:"
    echo "  mise run release:changelog-entry Added 'New feature for X (#123)'"
    echo "  mise run release:changelog-entry Fixed 'Bug in Y component (#456)'"
    exit 1
fi

# Validate category
case "$CATEGORY" in
    Added | Changed | Deprecated | Removed | Fixed | Security) ;;
    *)
        echo "ERROR: Invalid category '$CATEGORY'" >&2
        echo "Valid categories: Added, Changed, Deprecated, Removed, Fixed, Security" >&2
        exit 1
        ;;
esac

CHANGELOG="CHANGELOG.md"

if [ ! -f "$CHANGELOG" ]; then
    echo "ERROR: $CHANGELOG not found" >&2
    exit 1
fi

# Find the line number of the category under Unreleased
LINE=$(grep -n "### $CATEGORY" "$CHANGELOG" | head -1 | cut -d: -f1)

if [ -z "$LINE" ]; then
    echo "ERROR: Category '### $CATEGORY' not found in $CHANGELOG" >&2
    exit 1
fi

# Insert the entry after the category header.
#
# Written with awk rather than `sed -i`: BSD sed (macOS) reads the argument
# after -i as the backup suffix, so `sed -i "5a\\..."` consumed the address
# expression and left the file untouched while the task still reported
# success. awk behaves the same on every platform this repository is
# developed on.
TEMP="$(mktemp "${TMPDIR:-/tmp}/morphir-changelog.XXXXXX")"
trap 'rm -f "$TEMP"' EXIT
if ! awk -v line="$LINE" -v entry="- $ENTRY" \
    'NR == line { print; print entry; next } { print }' \
    "$CHANGELOG" >"$TEMP"; then
    echo "ERROR: could not rewrite $CHANGELOG" >&2
    exit 1
fi
cat "$TEMP" >"$CHANGELOG"

echo "Added entry to $CATEGORY section:"
echo "  - $ENTRY"
