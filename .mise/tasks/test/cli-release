#!/bin/sh
#MISE description="Publish, install and use an extension bundle through the released morphir CLI"
#USAGE arg "<id>" help="Extension short id: avro, openapi, python or rust"

# The extension bundles built here are hosted by the morphir CLI, which finos/morphir releases.
# This task is the compatibility check between the two: it takes the bundle that
# `extension:artifact:<id>` staged, publishes it to a local repository with the released CLI,
# installs it into a fresh Morphir Home, removes the repository, and then uses the extension.
#
# The CLI comes from a finos/morphir release pinned in `.config/morphir-cli-version`, so the
# check needs no checkout of that repository. MORPHIR_CLI overrides the download with a local
# binary, and MORPHIR_EXTENSION_BUNDLE overrides the staged bundle directory.

set -eu

ID="${usage_id:-${1:-}}"
case "$ID" in
    avro) EXTENSION_ID=morphir-avro ;;
    openapi) EXTENSION_ID=morphir-openapi ;;
    python) EXTENSION_ID=morphir-python ;;
    rust) EXTENSION_ID=morphir-rust ;;
    *)
        echo "usage: mise run test:cli-release <avro|openapi|python|rust>" >&2
        exit 2
        ;;
esac

REPO_ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/../../.." && pwd -P)"
cd "$REPO_ROOT"

VERSION=$(cat .config/morphir-cli-version)
BUNDLE="${MORPHIR_EXTENSION_BUNDLE:-$REPO_ROOT/.morphir/build/extensions/$ID}"
CLASSIC_IR="$REPO_ROOT/crates/morphir-core/tests/fixtures/ir/classic/greeting-example.json"

[ -d "$BUNDLE" ] || {
    echo "no bundle at $BUNDLE; run 'mise run extension:artifact:$ID' first." >&2
    exit 1
}

# ---- the released CLI ------------------------------------------------------------------------

sha256_of() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | cut -d' ' -f1
    else
        shasum -a 256 "$1" | cut -d' ' -f1
    fi
}

fetch_cli() {
    case "$(uname -s)" in
        Darwin) OS=apple-darwin ;;
        Linux) OS=unknown-linux-gnu ;;
        *)
            echo "test:cli-release downloads the CLI on Linux and macOS; set MORPHIR_CLI elsewhere." >&2
            exit 1
            ;;
    esac
    case "$(uname -m)" in
        arm64 | aarch64) ARCH=aarch64 ;;
        x86_64 | amd64) ARCH=x86_64 ;;
        *)
            echo "no morphir CLI is published for $(uname -m)." >&2
            exit 1
            ;;
    esac

    CLI_DIR="$REPO_ROOT/.dev/bin/morphir-$VERSION"
    MORPHIR_CLI="$CLI_DIR/morphir"
    [ -x "$MORPHIR_CLI" ] && return 0

    ASSET="morphir-$VERSION-$ARCH-$OS.tgz"
    RELEASE="https://github.com/finos/morphir/releases/download/v$VERSION"
    echo "Fetching the morphir CLI $VERSION ($ARCH-$OS)..." >&2
    # Unpacked beside the target and moved into place only once it is whole and verified, so an
    # interrupted fetch never leaves something the next run would take for a good cached copy.
    TEMP="$REPO_ROOT/.dev/bin/morphir-$VERSION.download.$$"
    rm -rf "$TEMP"
    mkdir -p "$TEMP"
    curl --fail --location --silent --show-error --output "$TEMP/$ASSET" "$RELEASE/$ASSET"
    curl --fail --location --silent --show-error --output "$TEMP/$ASSET.sha256" "$RELEASE/$ASSET.sha256"
    EXPECTED=$(cut -d' ' -f1 "$TEMP/$ASSET.sha256")
    ACTUAL=$(sha256_of "$TEMP/$ASSET")
    [ -n "$EXPECTED" ] && [ "$ACTUAL" = "$EXPECTED" ] || {
        echo "checksum mismatch for $ASSET: expected $EXPECTED, got $ACTUAL" >&2
        rm -rf "$TEMP"
        exit 1
    }
    tar -xzf "$TEMP/$ASSET" -C "$TEMP"
    rm -f "$TEMP/$ASSET" "$TEMP/$ASSET.sha256"
    rm -rf "$CLI_DIR"
    mv "$TEMP" "$CLI_DIR"
}

if [ -z "${MORPHIR_CLI:-}" ]; then
    fetch_cli
fi
echo "Using $("$MORPHIR_CLI" --version | tail -n 1) at $MORPHIR_CLI" >&2

# ---- a fresh home, repository and project ---------------------------------------------------

WORK="$(mktemp -d "${TMPDIR:-/tmp}/morphir-cli-release.XXXXXX")"
WORK="$(CDPATH='' cd -- "$WORK" && pwd -P)"
trap 'rm -rf "$WORK"' EXIT
trap 'exit 1' HUP INT TERM

export MORPHIR_HOME="$WORK/home"
PROJECT="$WORK/project"
mkdir -p "$PROJECT"

# `repository publish` takes a directory that holds exactly the descriptor, named release.json,
# the artifact and its checksum. The staged descriptor carries its download name.
PUBLISH="$WORK/bundle"
mkdir "$PUBLISH"
cp "$BUNDLE"/* "$PUBLISH"/
for descriptor in "$PUBLISH"/*.release.json; do
    [ -f "$descriptor" ] && mv "$descriptor" "$PUBLISH/release.json"
done
[ -f "$PUBLISH/release.json" ] || {
    echo "the bundle at $BUNDLE has no release descriptor." >&2
    exit 1
}

morphir() {
    echo "+ morphir $*" >&2
    (cd "$PROJECT" && "$MORPHIR_CLI" "$@")
}

require_file() {
    [ -s "$PROJECT/$1" ] || {
        echo "expected the CLI to write $1" >&2
        exit 1
    }
}

same_json() {
    python3 - "$PROJECT/$1" "$PROJECT/$2" <<'PY'
import json, sys
left, right = (json.load(open(path, encoding="utf-8")) for path in sys.argv[1:3])
if left != right:
    raise SystemExit(f"{sys.argv[1]} and {sys.argv[2]} differ")
PY
}

format_version() {
    python3 -c 'import json, sys; print(json.load(open(sys.argv[1], encoding="utf-8"))["formatVersion"])' "$PROJECT/$1"
}

morphir extension repository init "$WORK/repository"
morphir extension repository add local --directory "$WORK/repository"
morphir extension repository publish local --bundle "$PUBLISH"
morphir extension install --repository local "$EXTENSION_ID"
# The extension has to activate from Morphir Home alone.
rm -rf "$WORK/repository"
morphir extension list

# ---- use the extension -----------------------------------------------------------------------

case "$ID" in
    avro | openapi)
        # `generate` reads a project configuration even when --input names the IR.
        cat >"$PROJECT/morphir.toml" <<'TOML'
[project]
name = "Morphir.Example"
version = "1.0.0"
TOML
        ;;
esac

case "$ID" in
    avro)
        morphir generate --target avro --input "$CLASSIC_IR" --output out/avro
        [ -n "$(find "$PROJECT/out/avro" -type f | head -n 1)" ] || {
            echo "generate --target avro wrote nothing" >&2
            exit 1
        }
        ;;
    openapi)
        for target in openapi json-schema; do
            morphir generate --target "$target" --input "$CLASSIC_IR" --output "out/$target"
            [ -n "$(find "$PROJECT/out/$target" -type f | head -n 1)" ] || {
                echo "generate --target $target wrote nothing" >&2
                exit 1
            }
        done
        ;;
    python)
        mkdir -p "$PROJECT/src/domain"
        cat >"$PROJECT/morphir.toml" <<'TOML'
[project]
name = "acme/example"
version = "0.1.0"
source_directory = "src"
[frontend]
language = "python"
emit_parse_stage = false
TOML
        cat >"$PROJECT/src/domain/models.py" <<'PYSRC'
from dataclasses import dataclass
@dataclass(frozen=True)
class Point:
    coordinates: tuple[int, int]
PYSRC
        cat >"$PROJECT/src/domain/rules.py" <<'PYSRC'
from .models import Point
def choose(flag: bool, first: Point, second: Point) -> Point:
    if flag:
        return first
    else:
        return second
PYSRC
        morphir compile --language python --input src --output compiled
        morphir generate --target python --input compiled/morphir-ir.json --output generated
        require_file generated/domain/models.py
        require_file generated/domain/rules.py
        # Generated source has to compile back to the same IR.
        morphir compile --language python --input generated --output recompiled
        same_json compiled/morphir-ir.json recompiled/morphir-ir.json
        ;;
    rust)
        mkdir -p "$PROJECT/src"
        cat >"$PROJECT/morphir.toml" <<'TOML'
[project]
name = 'acme/example'
version = '0.1.0'
source_directory = 'src'
[frontend]
language = 'rust'
emit_parse_stage = false
[ir]
format_version = 3
TOML
        cat >"$PROJECT/src/models.rs" <<'RS'
pub enum Decision { Accept(i64), Reject }
pub type Pair = (i64, bool);
pub fn positive(value: i64) -> bool { value > 0 }
pub fn compute(decision: Decision, limit: i64) -> i64 {
    let above = |value: i64| -> bool { value > limit };
    match decision {
        Decision::Accept(value) => if above(value) { value } else { limit },
        Decision::Reject => 0,
    }
}
RS
        for version in 3 4; do
            if [ "$version" = 3 ]; then
                morphir compile --output "compiled-v$version"
            else
                morphir compile --ir-version 4 --output "compiled-v$version"
            fi
            [ "$(format_version "compiled-v$version/morphir-ir.json")" = "$version" ]
            morphir generate --target rust --output "generated-v$version"
            require_file "generated-v$version/lib.rs"
            # The generated library has to build and behave like its source.
            {
                cat "$PROJECT/generated-v$version/lib.rs"
                cat <<'RS'

fn main() {
    let pair: models::Pair = (42, true);
    assert_eq!(pair, (42, true));
    assert!(models::positive(1));
    assert!(!models::positive(0));
    assert_eq!(models::compute(models::Decision::Accept(12), 10), 12);
    assert_eq!(models::compute(models::Decision::Accept(8), 10), 10);
    assert_eq!(models::compute(models::Decision::Reject, 10), 0);
}
RS
            } >"$PROJECT/consumer_v$version.rs"
            rustc --edition 2024 -A dead_code -o "$PROJECT/consumer_v$version" "$PROJECT/consumer_v$version.rs"
            "$PROJECT/consumer_v$version"
        done
        ;;
esac

echo "The $EXTENSION_ID bundle works through morphir $VERSION." >&2
