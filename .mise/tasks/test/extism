#!/bin/sh
#MISE description="Build a real Extism guest and run its MEP conformance tests"

set -e

TARGET="wasm32-unknown-unknown"

if ! rustup target list --installed | grep -qx "$TARGET"; then
    echo "Installing Rust target $TARGET..." >&2
    rustup target add "$TARGET"
fi

cargo build --locked --release -p morphir-wasm-binding --target "$TARGET"
cargo test --locked -p morphir-daemon --test extism_extension -- --ignored
cargo build --locked --release -p morphir-avro-extension --target "$TARGET"
cargo test --locked -p morphir-daemon --test installed_wasm_extension -- --ignored
