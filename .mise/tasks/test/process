#!/bin/sh
#MISE description="Build real native extensions and run their MEP conformance, describe and parity tests"

set -e

cargo build -p morphir-host-native --example mep-native-backend --example mep-native-frontend

fixture() {
    if [ -f "target/debug/examples/$1.exe" ]; then
        echo "target/debug/examples/$1.exe"
    else
        echo "target/debug/examples/$1"
    fi
}

MEP_NATIVE_FIXTURE="$(fixture mep-native-backend)" \
MEP_NATIVE_FRONTEND_FIXTURE="$(fixture mep-native-frontend)" \
    cargo test -p morphir-host-native --test spawned_process_extension --test process_describe --test guest_parity -- --ignored
