{
  "description": "Incompleteness in its decided v4 spelling: a hole says why under `reason`, a draft takes an empty payload.",
  "examples": {
    "holeWithUnresolvedReference": {
      "Hole": {
        "reason": {
          "UnresolvedReference": {
            "target": "acme/finance:ledger#calculate-balance"
          }
        }
      }
    },
    "holeWithTypeMismatch": {
      "Hole": {
        "reason": {
          "TypeMismatch": {
            "expected": "morphir/SDK:basics#int",
            "found": "morphir/SDK:string#string"
          }
        }
      }
    },
    "holeWithDeletedDuringRefactor": {
      "Hole": {
        "reason": {
          "DeletedDuringRefactor": {
            "tx-id": "tx-2026-02-11"
          }
        }
      }
    },
    "draft": {
      "Draft": {}
    }
  }
}