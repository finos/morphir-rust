      "expectedCanonicalUri": "morphir://ir/workspace/team-orders-2?format=4.0.0#/module/domain/value/calculate-total"
    },
    {
      "id": "node-uri-0022",
      "purpose": "Uppercase workspace aliases are invalid",
      "uri": "morphir://ir/workspace/Orders?format=4.0.0#/module/domain/value/calculate-total",
      "expectedError": "invalid_node_uri"
    },
    {
      "id": "node-uri-0023",
      "purpose": "Unicode workspace aliases are invalid even when UTF-8 encoded",
      "uri": "morphir://ir/workspace/caf%C3%A9?format=4.0.0#/module/domain/value/calculate-total",
      "expectedError": "invalid_node_uri"
    },
    {
      "id": "node-uri-0024",
      "purpose": "A slash cannot be hidden inside a workspace alias",
      "uri": "morphir://ir/workspace/team%2Forders?format=4.0.0#/module/domain/value/calculate-total",
      "expectedError": "invalid_node_uri"
    },
    {
      "id": "node-uri-0025",
      "purpose": "A percent sign is not part of the workspace alias domain",
      "uri": "morphir://ir/workspace/a%25b?format=4.0.0#/module/domain/value/calculate-total",
      "expectedError": "invalid_node_uri"
    },
    {
      "id": "node-uri-0026",
      "purpose": "An empty workspace alias is invalid",
      "uri": "morphir://ir/workspace/?format=4.0.0#/module/domain/value/calculate-total",
      "expectedError": "invalid_node_uri"
    },
    {
      "id": "node-uri-0027",
      "purpose": "A workspace alias must use its literal canonical ASCII spelling",
      "uri": "morphir://ir/workspace/ord%65rs?format=4.0.0#/module/domain/value/calculate-total",
      "expectedError": "invalid_node_uri"
    },
    {
      "id": "node-uri-0028",
      "purpose": "A workspace alias cannot end with a hyphen",
      "uri": "morphir://ir/workspace/orders-?format=4.0.0#/module/domain/value/calculate-total",
      "expectedError": "invalid_node_uri"
    },
    {
      "id": "node-uri-0029",
      "purpose": "An unescaped slash creates an invalid extra workspace path segment",
      "uri": "morphir://ir/workspace/team/orders?format=4.0.0#/module/domain/value/calculate-total",
      "expectedError": "invalid_node_uri"
