      "expectedAddress": {
        "artifact": {
          "kind": "package",
          "packagePath": "acme/orders"
        },
        "formatVersion": "3.0.0",
        "root": {
          "kind": "value",
          "module": "domain",
          "name": "calculate-total",
          "owner": {
            "kind": "own-package"
          }
        },
        "steps": [
          {
            "kind": "body"
          },
          {
            "kind": "apply-argument"
          }
        ],
        "revision": {
          "kind": "current"
        },
        "guard": null
      },
      "expectedCanonicalUri": "morphir://ir/pkg/acme/orders?format=3.0.0#/module/domain/value/calculate-total/body/apply/argument"
    },
    {
      "id": "node-uri-0003",
      "purpose": "A slash within one module path component is percent encoded",
      "uri": "morphir://ir/pkg/acme/orders?format=4.0.0#/module/sales%2Forders/type/order",
      "expectedAddress": {
        "artifact": {
          "kind": "package",
          "packagePath": "acme/orders"
        },
        "formatVersion": "4.0.0",
        "root": {
          "kind": "type",
          "module": "sales/orders",
          "name": "order",
          "owner": {
            "kind": "own-package"
          }
        },
        "steps": [],
        "revision": {
          "kind": "current"
        },
        "guard": null
      },
      "expectedCanonicalUri": "morphir://ir/pkg/acme/orders?format=4.0.0#/module/sales%2Forders/type/order"
    },
    {
      "id": "node-uri-0004",
      "purpose": "A pin selects one immutable artifact revision",
      "uri": "morphir://ir/pkg/acme/orders?format=4.0.0&rev=sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa#/module/domain/type/order",
      "expectedAddress": {
        "artifact": {
          "kind": "package",
          "packagePath": "acme/orders"
        },
        "formatVersion": "4.0.0",
        "root": {
          "kind": "type",
          "module": "domain",
          "name": "order",
          "owner": {
            "kind": "own-package"
          }
        },
        "steps": [],
        "revision": {
          "kind": "pinned",
          "algorithm": "sha256",
          "digest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        },
        "guard": null
      },
      "expectedCanonicalUri": "morphir://ir/pkg/acme/orders?format=4.0.0&rev=sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa#/module/domain/type/order"
    },
    {
      "id": "node-uri-0005",
      "purpose": "A current workspace alias requires resolver context",
      "uri": "morphir://ir/workspace/orders?format=4.0.0#/module/domain/value/calculate-total",
      "expectedAddress": {
        "artifact": {
          "kind": "workspace",
          "alias": "orders"
        },
        "formatVersion": "4.0.0",
        "root": {
          "kind": "value",
          "module": "domain",
          "name": "calculate-total",
          "owner": {
            "kind": "own-package"
          }
        },
        "steps": [],
        "revision": {
          "kind": "current"
        },
        "guard": null
      },
      "expectedCanonicalUri": "morphir://ir/workspace/orders?format=4.0.0#/module/domain/value/calculate-total"
    },
    {
      "id": "node-uri-0006",
      "purpose": "A bare artifact format family is not a canonical exact URI version",
      "uri": "morphir://ir/pkg/acme/orders?format=4#/module/domain/type/order",
      "expectedError": "invalid_node_uri"
    },
    {
      "id": "node-uri-0007",
      "purpose": "Duplicate query parameters are ambiguous",
      "uri": "morphir://ir/pkg/acme/orders?format=4.0.0&format=3.0.0#/module/domain/type/order",
      "expectedError": "invalid_node_uri"
    },
    {
      "id": "node-uri-0008",
      "purpose": "A lower-case percent escape is not canonical",
      "uri": "morphir://ir/pkg/acme/orders?format=4.0.0#/module/sales%2forders/type/order",
      "expectedError": "invalid_node_uri"
    },
    {
      "id": "node-uri-0009",
      "purpose": "Ordered indices are nonnegative canonical decimal integers",
      "uri": "morphir://ir/pkg/acme/orders?format=4.0.0#/module/domain/type/pair/type-exp/tuple/element/01",
      "expectedError": "invalid_node_uri"
    },
    {
      "id": "node-uri-0010",
      "purpose": "A decoded Unicode word outside the Morphir name grammar is rejected",
      "uri": "morphir://ir/pkg/acme/orders?format=4.0.0#/module/domain/type/caf%C3%A9",
      "expectedError": "invalid_node_uri"
    },
    {
      "id": "node-uri-0011",
      "purpose": "An unpinned ordered path carries a guard for its ordered-step lineage",
      "uri": "morphir://ir/pkg/acme/orders?format=4.0.0&guard=sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb#/module/domain/type/pair/type-exp/tuple/element/1",
      "expectedAddress": {
        "artifact": {
          "kind": "package",
          "packagePath": "acme/orders"
        },
        "formatVersion": "4.0.0",
        "root": {
          "kind": "type",
          "module": "domain",
          "name": "pair",
          "owner": {
            "kind": "own-package"
          }
        },
        "steps": [
          {
            "kind": "type-expression"
          },
          {
            "kind": "tuple-element",
            "index": 1
          }
        ],
        "revision": {
          "kind": "current"
        },
        "guard": {
          "algorithm": "sha256",
          "digest": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
        }
      },
      "expectedCanonicalUri": "morphir://ir/pkg/acme/orders?format=4.0.0&guard=sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb#/module/domain/type/pair/type-exp/tuple/element/1"
    },
    {
      "id": "node-uri-0012",
      "purpose": "An unpinned ordered child without a guard is unsafe",
      "uri": "morphir://ir/pkg/acme/orders?format=4.0.0#/module/domain/type/pair/type-exp/tuple/element/1",
      "expectedError": "invalid_node_uri"
    },
    {
      "id": "node-uri-0013",
      "purpose": "A pinned ordered child needs no guard",
      "uri": "morphir://ir/pkg/acme/orders?format=4.0.0&rev=sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa#/module/domain/type/pair/type-exp/tuple/element/1",
      "expectedAddress": {
        "artifact": {
          "kind": "package",
          "packagePath": "acme/orders"
        },
        "formatVersion": "4.0.0",
        "root": {
          "kind": "type",
          "module": "domain",
          "name": "pair",
          "owner": {
            "kind": "own-package"
          }
        },
        "steps": [
          {
            "kind": "type-expression"
          },
          {
            "kind": "tuple-element",
            "index": 1
          }
        ],
        "revision": {
          "kind": "pinned",
          "algorithm": "sha256",
          "digest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        },
        "guard": null
      },
      "expectedCanonicalUri": "morphir://ir/pkg/acme/orders?format=4.0.0&rev=sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa#/module/domain/type/pair/type-exp/tuple/element/1"
    },
    {
      "id": "node-uri-0014",
      "purpose": "Unknown query parameters do not silently change resolution",
      "uri": "morphir://ir/pkg/acme/orders?format=4.0.0&latest=true#/module/domain/type/order",
      "expectedError": "invalid_node_uri"
    },
    {
