{
  "contractVersion": "0.1.0-draft.1",
  "uriCases": [
    {
      "id": "node-uri-0001",
      "purpose": "A V4 named record field has one address in all serialization profiles",
      "uri": "morphir://ir/pkg/acme/orders?format=4.0.0#/module/domain/type/order/type-exp/record/field/customer-id",
      "expectedAddress": {
        "artifact": {
          "kind": "package",
          "packagePath": "acme/orders"
        },
        "formatVersion": "4.0.0",
        "root": {
          "kind": "type",
          "module": "domain",
          "name": "order",
          "owner": {
            "kind": "own-package"
          }
        },
        "steps": [
          {
            "kind": "type-expression"
          },
          {
            "kind": "record-field",
            "name": "customer-id"
          }
        ],
        "revision": {
          "kind": "current"
        },
        "guard": null
      },
      "profiles": [
        "json",
        "yaml",
        "document-tree"
      ],
      "expectedCanonicalUri": "morphir://ir/pkg/acme/orders?format=4.0.0#/module/domain/type/order/type-exp/record/field/customer-id"
    },
    {
      "id": "node-uri-0002",
      "purpose": "A V3 Apply argument is a typed branch rather than a bare child index",
