          "kind": "current"
        },
        "guard": null,
        "root": {
          "kind": "package",
          "owner": {
            "kind": "own-package"
          }
        }
      },
      "expectedCanonicalUri": "morphir://ir/pkg/acme/orders?format=4.0.0#/package"
    },
    {
