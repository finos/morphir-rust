    {
      "id": "node-uri-0021",
      "purpose": "A canonical workspace alias can contain lowercase words and digits separated by hyphens",
      "uri": "morphir://ir/workspace/team-orders-2?format=4.0.0#/module/domain/value/calculate-total",
      "expectedAddress": {
        "artifact": {
          "kind": "workspace",
          "alias": "team-orders-2"
