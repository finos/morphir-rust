  {
    "name": "global-and-adjacent-user-priority",
    "request": {
      "protocolVersion": 1,
      "developmentRoot": { "entries": {
        "morphir.toml": { "kind": "file", "text": "[workspace]\nname = \"primary-workspace\"\nmembers = [\"packages/member\"]\n\n[project]\nname = \"priority/root\"\nversion = \"1.0.0\"\nsource_directory = \"primary-root\"\n\n[ir]\nmode = \"workspace-primary\"\n" },
        "morphir.user.toml": { "kind": "file", "text": "[workspace]\nname = \"user-workspace\"\n\n[project]\nversion = \"2.0.0\"\nsource_directory = \"workspace-user\"\n\n[ir]\nmode = \"workspace-user\"\n" },
        "packages": { "kind": "directory" },
        "packages/member": { "kind": "directory" },
        "packages/member/morphir.yaml": { "kind": "file", "text": "project:\n  name: priority/member-primary\n  version: 1.0.0\n  source_directory: member-primary\nir:\n  mode: member-primary\n" },
        "packages/member/morphir.user.yaml": { "kind": "file", "text": "project:\n  name: priority/member-user\n  version: 3.0.0\n  source_directory: member-user\nir:\n  mode: member-user\n" }
      } },
      "morphirHome": { "entries": {
        ".config": { "kind": "directory" },
        ".config/morphir": { "kind": "directory" },
        ".config/morphir/config.toml": { "kind": "file", "text": "[project]\nname = \"must/not/inherit\"\nsource_directory = \"global-project\"\n\n[ir]\nmode = \"global\"\n" }
      } },
      "systemConfig": null,
      "environment": { "MORPHIR_PROJECT__VERSION": "4.0.0" },
      "cliOverlay": { "project": { "source_directory": "cli-source" } }
    },
    "expected": { "status": "success", "snapshot": {
      "protocolVersion": 1, "configAnchor": "morphir.toml", "name": "user-workspace", "state": "open",
      "projects": [
        { "name": "priority/root", "version": "4.0.0", "relativePath": ".", "configAnchor": "morphir.toml", "sourceDirectory": "cli-source", "state": "unloaded", "diagnostics": [] },
        { "name": "priority/member-user", "version": "4.0.0", "relativePath": "packages/member", "configAnchor": "packages/member/morphir.yaml", "sourceDirectory": "cli-source", "state": "unloaded", "diagnostics": [] }
      ],
      "diagnostics": []
    } }
  },
